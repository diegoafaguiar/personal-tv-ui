# risk: keep
# NUNCA desabilite estes pacotes. scripts/30-debloat.sh recusa qualquer um
# deles mesmo que outro perfil peça. Globs (*) são permitidos.
#
# Por que cada grupo importa:
# - Android core / Google core: boot, Play Store, login, WebView, permissões.
# - Input: perder isso = controle remoto morto. Sem ADB, só factory reset.
# - TCL/SoC: HDMI, tuner, menu de fontes, drivers de vídeo/áudio.
# - Launcher substituto: desabilitar sem outro Home = tela preta.

# --- Android core ---
android
com.android.systemui
com.android.settings*
com.android.tv.settings*
com.android.providers.settings
com.android.providers.media*
com.android.providers.tv
com.android.providers.downloads
com.android.packageinstaller
com.android.shell
com.android.bluetooth
com.android.networkstack*
com.android.wifi*
com.android.tethering*
com.android.se
com.android.keychain
com.android.certinstaller
com.android.externalstorage

# --- Google core (Play Store, Services, WebView, permissões) ---
com.android.vending
com.google.android.gms
com.google.android.gsf
com.google.android.webview
com.google.android.packageinstaller
com.google.android.permissioncontroller
com.google.android.ext.services
com.google.android.ext.shared
com.google.android.modulemetadata
com.google.android.overlay.*

# --- Input: perder isso = controle remoto sem resposta ---
com.google.android.tv.remote.service   # também carrega o botão do microfone do remoto BT
com.google.android.inputmethod.latin
*.inputmethod.*
*.globalkeyoverlay
*.autopair
*.keycustomfunctionservice
*.tcl_bt_rcu_service

# --- TCL: TV ao vivo, HDMI, menu de fontes, atualização ---
com.tcl.tv                 # Live TV + player de HDMI/antena
com.tcl.tvinput            # TV Input Framework: tuner + HDMI 1-3
*.tvinput
com.tcl.suspension         # painel de fontes do botão Input
com.tcl.sourcemananger     # (sic) gerenciador de fontes nos Android TV 9
com.tcl.dashboard          # painel de configurações rápidas (ícone de engrenagem)
com.tcl.systemserver
com.tcl.system.server
*.systemserver
*.providers.config
com.tcl.systemui.plugin
com.tcl.initsetup
com.tcl.factory.view       # nunca abra; mas desabilitar quebra menus em alguns firmwares
com.tcl.framework.custom
com.tcl.keyhelp
com.tcl.settings
com.tcl.versionUpdateApp   # atualização de firmware (Android TV 9)
com.tcl.rc.ota             # atualização OTA
com.tcl.eva                # serviço de boot com permissões de sistema (papel pouco claro)
com.tvos
tv.mopa.ginga              # middleware Ginga da TV aberta brasileira (interatividade DTV)

# --- Drivers e serviços do SoC (vídeo, áudio, Dolby) ---
com.realtek.*
com.mediatek.*
com.amlogic.*
com.droidlogic*            # framework Android da Amlogic (com.droidlogic, .overlay, .imageplayer, ...)
com.dolby.*
com.tpa.kb

# --- TV aberta brasileira (Ginga / DTVi) ---
com.mirakulo.*             # AstroTV: middleware Ginga da Mirakulo (TV aberta interativa)

# --- TCL: setup e WebView próprio ---
com.tcl.useragreement      # tela de termos do setup; mantido em todas as listas G08
com.tcl.android.webview    # WebView da TCL usado por apps do sistema

# --- AOSP: sem ganho em desabilitar e com risco de crash/OTA. Classificados KEEP
#     para você não gastar tempo pesquisando. Nenhum roda em background relevante.
android.auto_generated_rro_*   # overlays de recursos gerados no build
com.android.backupconfirm
com.android.captiveportallogin # login em Wi-Fi com portal (hotel, aeroporto)
com.android.companiondevicemanager  # pareamento de dispositivos companheiros (controle BT)
com.android.connectivity.resources
com.android.cts.*              # shims de compatibilidade, vazios
com.android.dynsystem          # Dynamic System Updates
com.android.hotspot2.osulogin  # Passpoint
com.android.htmlviewer
com.android.inputdevices       # layouts de teclado/controle
com.android.localtransport     # transporte de backup
com.android.location.fused
com.android.managedprovisioning
com.android.mtp                # USB
com.android.pacprocessor       # proxy
com.android.proxyhandler
com.android.providers.calendar
com.android.providers.contacts
com.android.providers.userdictionary
com.android.sharedstoragebackup
com.android.soundpicker
com.android.statementservice   # verificação de App Links
com.android.systemui.*
com.android.tv.frameworkpackagestubs  # responde intents sem app; evita crashes "No Activity found"
com.android.tv.overlay.*
com.android.vpndialogs
com.android.wallpaperbackup

# --- Home de fábrica e setup (regra do dono: nunca desligar) ---
com.google.android.apps.tv.launcherx       # tela inicial do Google TV
com.google.android.tvlauncher              # tela inicial do Android TV
com.google.android.tungsten.setupwraith    # assistente de configuração

