# Configuração local com o IP de cada TV (não versionar: é específico da sua rede)
android-tv/config/tv.env
devices/*.env
roku/config/roku.env

# Backups e relatórios gerados a partir da TV.
# Contêm dumps de settings que podem incluir SSID de Wi-Fi, contas Google e
# identificadores do aparelho. Versione conscientemente: remova o "!" abaixo
# se quiser guardar um backup específico no repositório.
backups/*
!backups/.gitkeep
reports/*
!reports/.gitkeep

# Artefatos de teste
android-tv/tests/.state/
roku/tests/.state/

# Sistema
.DS_Store
*.log
vendor/

# Launcher Android (Gradle)
android-tv/launcher/.gradle/
android-tv/launcher/build/
android-tv/launcher/app/build/
android-tv/launcher/local.properties
android-tv/launcher/.idea/
android-tv/launcher/*.iml
android-tv/launcher/app/*.iml
android-tv/launcher/.kotlin/
android-tv/launcher/dist/

# Planos gerados pela revisão interativa (android-tv/scripts/25-review.sh): são da sua TV
android-tv/config/profiles/planos/
