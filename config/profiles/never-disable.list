# risk: keep
# NUNCA desabilite estes pacotes. scripts/30-debloat.sh recusa qualquer um
# deles mesmo que outro perfil peça. Globs (*) são permitidos.
#
# Por que cada grupo importa:
# - Android core / Google core: boot, Play Store, login, WebView, permissões.
# - Input: perder isso = controle remoto morto. Sem ADB, só factory reset.
# - TCL/SoC: HDMI, tuner, menu de fontes, drivers de vídeo/áudio.
# - Launcher substituto: desabilitar sem outro Home = tela preta.

# --- Android core ---
android
com.android.systemui
com.android.settings*
com.android.tv.settings*
com.android.providers.settings
com.android.providers.media*
com.android.providers.tv
com.android.providers.downloads
com.android.packageinstaller
com.android.shell
com.android.bluetooth
com.android.networkstack*
com.android.wifi*
com.android.tethering*
com.android.se
com.android.keychain
com.android.certinstaller
com.android.externalstorage

# --- Google core (Play Store, Services, WebView, permissões) ---
com.android.vending
com.google.android.gms
com.google.android.gsf
com.google.android.webview
com.google.android.packageinstaller
com.google.android.permissioncontroller
com.google.android.ext.services
com.google.android.ext.shared
com.google.android.modulemetadata
com.google.android.overlay.*

# --- Input: perder isso = controle remoto sem resposta ---
com.google.android.tv.remote.service   # também carrega o botão do microfone do remoto BT
com.google.android.inputmethod.latin
*.inputmethod.*
*.globalkeyoverlay
*.autopair
*.keycustomfunctionservice
*.tcl_bt_rcu_service

# --- TCL: TV ao vivo, HDMI, menu de fontes, atualização ---
com.tcl.tv                 # Live TV + player de HDMI/antena
com.tcl.tvinput            # TV Input Framework: tuner + HDMI 1-3
*.tvinput
com.tcl.suspension         # painel de fontes do botão Input
com.tcl.sourcemananger     # (sic) gerenciador de fontes nos Android TV 9
com.tcl.dashboard          # painel de configurações rápidas (ícone de engrenagem)
com.tcl.systemserver
com.tcl.system.server
*.systemserver
*.providers.config
com.tcl.systemui.plugin
com.tcl.initsetup
com.tcl.factory.view       # nunca abra; mas desabilitar quebra menus em alguns firmwares
com.tcl.framework.custom
com.tcl.keyhelp
com.tcl.settings
com.tcl.versionUpdateApp   # atualização de firmware (Android TV 9)
com.tcl.rc.ota             # atualização OTA
com.tcl.eva                # serviço de boot com permissões de sistema (papel pouco claro)
com.tvos
tv.mopa.ginga              # middleware Ginga da TV aberta brasileira (interatividade DTV)

# --- Drivers e serviços do SoC (vídeo, áudio, Dolby) ---
com.realtek.*
com.mediatek.*
com.amlogic.*
com.dolby.*
com.tpa.kb

# --- Seu launcher substituto ---
com.spocky.projengmenu     # Projectivy Launcher
me.efesser.flauncher       # FLauncher
com.wolf.launcher          # Wolf Launcher
com.gathin.tvhome          # Clean Your TV launcher
